+  const [requests, setRequests] = useState<Request[]>([])
+  const [loaded, setLoaded] = useState(false)
+
+  useEffect(() => {
+    ;(async () => {
+      const { data, error } = await supabase.rpc('topic_requests', { p_limit: 100 })
+      if (error) onError(error.message)
+      setRequests((data as Request[]) ?? [])
+      setLoaded(true)
