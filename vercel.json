{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "app.neuromuscular.ca" }],
      "status": 307,
      "headers": { "Location": "/login" }
    },
    { "src": "/", "dest": "/program.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 12 * * *"
    }
  ]
}
